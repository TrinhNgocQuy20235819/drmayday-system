meta {
  name: 07. Cập nhật hồ sơ khi đang nháp (PUT /medical_records/:id)
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/medical_records/{{recordId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{patientToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "ly_do_den_kham": "Cập nhật: nổi sẩn phù nhiều về đêm kèm ngứa rát"
  }
}
