meta {
  name: 08. Lưu/Upsert câu trả lời động Sub DB (PUT /medical_records/:id/answers)
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/medical_records/{{recordId}}/answers
  body: json
  auth: bearer
}

auth:bearer {
  token: {{patientToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "answers": [
      {
        "question_id": "Q_ITCH_DURATION",
        "answer_text": "Ngứa nhiều về đêm trên 6 tuần",
        "option_value": "GE_24H"
      }
    ]
  }
}

script:post-response {
  const b = res.getBody();
  const ans = b && b.data && Array.isArray(b.data.answers) && b.data.answers[0] && b.data.answers[0].id;
  if (ans) { bru.setEnvVar("answerId", String(ans)); console.log("📝 answerId =", ans); }
}
