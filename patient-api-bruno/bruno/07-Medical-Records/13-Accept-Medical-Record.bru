meta {
  name: 13. Bác sĩ tiếp nhận hồ sơ (POST /medical_records/:id/accept)
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/medical_records/{{recordId}}/accept
  body: json
  auth: bearer
}

auth:bearer {
  token: {{doctorToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "tom_tat_buoi_kham": "Tiếp nhận bệnh án mày đay mạn tính để thăm khám"
  }
}

script:post-response {
  const b = res.getBody();
  const sid = b && b.data && b.data.active_session && b.data.active_session.ma_phien_kham;
  if (sid) { bru.setEnvVar("sessionId", String(sid)); console.log("🩺 Đã lưu {{sessionId}} =", sid); }
}
