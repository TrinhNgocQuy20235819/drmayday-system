meta {
  name: 09. Lấy danh sách câu trả lời phiếu khám (GET /medical_records/:id/answers)
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/medical_records/{{recordId}}/answers
  body: none
  auth: bearer
}

auth:bearer {
  token: {{patientToken}}
}

script:post-response {
  const b = res.getBody();
  const ans = b && b.data && Array.isArray(b.data.answers) && b.data.answers[0] && b.data.answers[0].id;
  if (ans) { bru.setEnvVar("answerId", String(ans)); console.log("📝 Đã lưu {{answerId}} =", ans); }
}
