meta {
  name: 14. Bác sĩ hoàn tất hồ sơ (POST /medical_records/:id/complete)
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/medical_records/{{recordId}}/complete
  body: json
  auth: bearer
}

auth:bearer {
  token: {{doctorToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "doctor_conclusion": "Mày đay mạn tính tự phát đáp ứng tốt thuốc kháng Histamin H1",
    "doctor_notes": "Theo dõi UAS7 hàng ngày và tái khám sau 4 tuần"
  }
}
