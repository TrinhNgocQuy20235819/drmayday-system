meta {
  name: 03. Tạo hồ sơ bệnh án (POST /medical_records)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/medical_records
  body: json
  auth: bearer
}

auth:bearer {
  token: {{patientToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "patient_id": "{{patientId}}",
    "template_id": "{{templateId}}",
    "loai_benh_an": "MAN",
    "thoi_gian_khoi_phat_tuan": 8,
    "ly_do_den_kham": "Mẩn ngứa nổi sẩn phù tái phát nhiều lần trên 6 tuần"
  }
}

script:post-response {
  const b = res.getBody();
  const rid = b && b.data && (b.data.ma_ho_so || b.data.medical_record_id);
  if (rid) { bru.setEnvVar("recordId", String(rid)); console.log("📄 Đã lưu {{recordId}} =", rid); }
}
