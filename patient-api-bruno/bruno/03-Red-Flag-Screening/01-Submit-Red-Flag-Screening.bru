meta {
  name: 01. Gửi sàng lọc báo động đỏ (POST /red-flag-screening)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/red-flag-screening
  body: json
  auth: bearer
}

auth:bearer {
  token: {{patientToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "co_kho_tho_kho_khe_nghen_hong": false,
    "co_chong_mat_tuc_nguc_sap_ngat": false,
    "co_sung_moi_luoi_co_hong": false,
    "co_dau_bung_non_lien_tuc": false
  }
}
