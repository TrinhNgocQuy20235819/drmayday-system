meta {
  name: 01. Tạo kết quả cận lâm sàng (POST /lab-results)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/lab-results
  body: json
  auth: bearer
}

auth:bearer {
  token: {{doctorToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "ma_ho_so": "{{recordId}}",
    "ma_phien_kham": "{{sessionId}}",
    "wbc": 8.5,
    "crp": 2.1,
    "lym": 2,
    "neu": 5.5,
    "plt": 240
  }
}
