meta {
  name: 01. Upload ảnh vào Supabase Storage (POST /image-attachments/upload)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/image-attachments/upload
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{patientToken}}
}

body:multipart-form {
  file: @file()
  medical_record_id: {{recordId}}
  body_part: Cánh tay phải
  notes: Ảnh chụp kiểm thử upload Supabase Storage
}

script:post-response {
  const b = res.getBody();
  const aid = b && b.data && (b.data.ma_tep_dinh_kem || b.data.id || b.data.sub_id);
  if (aid) { bru.setEnvVar("attachmentId", String(aid)); console.log("🖼️ Đã lưu {{attachmentId}} =", aid); }
}
