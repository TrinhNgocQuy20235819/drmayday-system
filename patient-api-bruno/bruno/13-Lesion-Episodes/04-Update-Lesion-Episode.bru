meta {
  name: 04. Cập nhật đợt tổn thương (PATCH /lesion-episodes/:id)
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/lesion-episodes/{{episodeId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{patientToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Đợt bùng phát (Đã cập nhật)",
    "description": "Giảm ngứa sau khi uống thuốc"
  }
}
