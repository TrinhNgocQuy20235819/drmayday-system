meta {
  name: 04. Đăng nhập Admin (POST /auth/login)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "phone": "{{adminUser}}",
    "password": "{{adminPassword}}"
  }
}

script:pre-request {
  if (!bru.getEnvVar("adminUser")) { bru.setEnvVar("adminUser", "0900000001"); }
  if (!bru.getEnvVar("adminPassword")) { bru.setEnvVar("adminPassword", "Admin@123"); }
}

script:post-response {
  const b = res.getBody();
  const token = b && b.data && (b.data.access_token || b.data.token);
  if (res.getStatus() === 200 && token) {
    bru.setEnvVar("adminToken", token);
    console.log("✅ Đã lưu {{adminToken}}");
  }
}
