meta {
  name: 07. Đổi mật khẩu (POST /auth/change-password)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/auth/change-password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{patientToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "old_password": "{{testPatientPassword}}",
    "new_password": "{{testPatientPassword}}",
    "confirm_password": "{{testPatientPassword}}"
  }
}
