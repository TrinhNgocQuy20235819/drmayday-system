meta {
  name: 01. Chấm điểm phù mạch AAS (POST /aas-scores)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/aas-scores
  body: json
  auth: bearer
}

auth:bearer {
  token: {{patientToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "ma_ho_so_man": "{{recordId}}",
    "score_date": "2026-11-13",
    "co_dot_sung_phu": true,
    "muc_kho_chiu": 2,
    "han_che_hoat_dong": 1,
    "anh_huong_ngoai_hinh": 1,
    "do_nang_tong_the": 2
  }
}
