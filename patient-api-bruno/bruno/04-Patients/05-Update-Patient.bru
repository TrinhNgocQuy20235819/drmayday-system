meta {
  name: 05. Cập nhật hành chính bệnh nhân (PUT /patients/:id)
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/patients/{{patientId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{patientToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "dia_chi_tinh_tp": "Hà Nội",
    "nghe_nghiep": "Khac",
    "nguoi_nha_so_dien_thoai": "0988111222"
  }
}
