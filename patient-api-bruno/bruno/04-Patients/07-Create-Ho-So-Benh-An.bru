meta {
  name: 07. Tạo hồ sơ bệnh án mới (POST /patients/ho-so)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/patients/ho-so
  body: json
  auth: bearer
}

auth:bearer {
  token: {{doctorToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "ma_benh_nhan": "{{patientId}}",
    "loai_benh_an": "MAN",
    "thoi_gian_khoi_phat_tuan": 8,
    "chan_doan_ban_dau_phong_kham": "Mày đay mạn tính tự phát"
  }
}

script:post-response {
  const b = res.getBody();
  const rid = b && b.data && (b.data.ma_ho_so || b.data.medical_record_id);
  if (rid) { bru.setEnvVar("recordId", String(rid)); console.log("📄 recordId =", rid); }
}
