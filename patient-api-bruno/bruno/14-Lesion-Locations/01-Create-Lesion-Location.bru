meta {
  name: 01. Thêm vị trí tổn thương (POST /lesion-locations)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/lesion-locations
  body: json
  auth: bearer
}

auth:bearer {
  token: {{patientToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "episode_id": "{{episodeId}}",
    "body_part": "Cánh tay phải",
    "occurred_at": "2026-11-13 20:15:00"
  }
}

script:post-response {
  const b = res.getBody();
  const lid = b && b.data && (b.data.ma_vi_tri_ton_thuong || b.data.lesion_location_id);
  if (lid) { bru.setEnvVar("locationId", String(lid)); console.log("📍 Đã lưu {{locationId}} =", lid); }
}
