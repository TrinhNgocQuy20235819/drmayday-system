meta {
  name: 02. Ghi nhật ký UAS7 Clinical (POST /clinical/uas7/nhat-ky)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/clinical/uas7/nhat-ky
  body: json
  auth: bearer
}

auth:bearer {
  token: {{patientToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "ma_chu_ky": 1,
    "ngay_ghi_nhan": "2026-11-13",
    "diem_ngua_sang": 1,
    "diem_san_sang": 2,
    "diem_ngua_toi": 2,
    "diem_san_toi": 1
  }
}
